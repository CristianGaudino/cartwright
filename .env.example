# Names only. Copy to .env.local for local work and never commit real values.

# Neon Postgres. Locally a Neon dev branch; the GitHub secret (deploy.yml migrates with it) and the Worker secret use main.
DATABASE_URL=
# Where lead emails go. A Worker secret.
LEAD_TO_EMAIL=
# Turnstile server key that checks the bot token. A Worker secret.
TURNSTILE_SECRET_KEY=
# Turnstile site key. Public, inlined at build (deploy.yml env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
