# Names only. Copy to .env.local for local work and never commit real values.

# Where lead emails go. A Worker secret. Set it before TURNSTILE_SECRET_KEY: with no address, leads are refused rather than saved unseen.
LEAD_TO_EMAIL=
# Turnstile server key that checks the bot token. A Worker secret.
TURNSTILE_SECRET_KEY=
# Turnstile site key. Public, inlined at build (deploy.yml env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Signs the trade-in photo links in the dealer email (HMAC, 7 days). A Worker secret: 32 random bytes, never committed.
PHOTO_LINK_SECRET=
# Google reviews (Places API New). Both unset means demo reviews under a Demo pill. Worker secrets.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
