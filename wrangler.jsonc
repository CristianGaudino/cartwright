{
	// Demo domain on the cgaudino.com zone (already on Cloudflare). Swap for the client's domain at handover.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "cartwright",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
	"services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cartwright" }],
	"routes": [{ "pattern": "carright.cgaudino.com", "custom_domain": true }],
	"workers_dev": false,
	"observability": { "enabled": true },
	// Lead emails to the dealer (D-01). No "remote": CI's wrangler dev has no Cloudflare credentials, so it uses the local simulator.
	"send_email": [{ "name": "EMAIL" }],
	// Per-IP limit on lead submits (D-05), a second layer behind Turnstile: 5 per minute.
	"ratelimits": [{ "name": "LEAD_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
